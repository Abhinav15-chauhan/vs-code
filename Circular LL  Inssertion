#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

// Insert at the beginning
struct Node* insertBeginning(struct Node *last, int data) {
    struct Node *newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = data;

    if (last == NULL) {
        newNode->next = newNode;
        last = newNode;
    } else {
        newNode->next = last->next;
        last->next = newNode;
    }

    return last;
}

// Display circular linked list
void display(struct Node *last) {
    if (last == NULL) {
        printf("List is empty\n");
        return;
    }

    struct Node *temp = last->next;

    do {
        printf("%d -> ", temp->data);
        temp = temp->next;
    } while (temp != last->next);

    printf("(back to first node)\n");
}

int main() {
    struct Node *last = NULL;

    last = insertBeginning(last, 30);
    last = insertBeginning(last, 20);
    last = insertBeginning(last, 10);

    display(last);

    return 0;
}
